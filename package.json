{
  "name": "vue2-jsx-browser",
  "version": "0.1.1",
  "packageManager": "pnpm@10.0.0",
  "description": "Vue 2 JSX Babel plugins for browser compilation",
  "keywords": [
    "vue2",
    "jsx",
    "babel",
    "browser"
  ],
  "author": "darkingtail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicepkg/vue2-jsx-browser.git"
  },
  "homepage": "https://github.com/nicepkg/vue2-jsx-browser#readme",
  "bugs": {
    "url": "https://github.com/nicepkg/vue2-jsx-browser/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/helper-module-imports": "^7.25.9",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@vue/babel-helper-vue-jsx-merge-props": "^1.4.0",
    "@vue/babel-sugar-functional-vue": "^1.4.0",
    "@vue/babel-sugar-v-model": "^1.4.0",
    "@vue/babel-sugar-v-on": "^1.4.0",
    "html-tags": "^5.1.0",
    "lodash.kebabcase": "^4.1.1",
    "svg-tags": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__helper-module-imports": "^7.18.3",
    "@types/lodash.kebabcase": "^4.1.9",
    "husky": "^9.0.0",
    "semantic-release": "^24.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0"
  }
}
